# Copy to .env. Local dev only; contains no secrets.

# Where the FastAPI app is listening. Every endpoint this site calls is public —
# signup has no login yet, by definition — so no token or tenant header is sent.
# The API's CORS_ORIGINS must include this site's origin (http://localhost:5175).
VITE_API_BASE_URL=http://localhost:8000

# Where a paid signup is sent at the end. The API returns this too (from its own
# DASHBOARD_URL), and the API's value wins — this is only the fallback for the
# "Sign in" link in the header, which is rendered before any API call happens.
VITE_DASHBOARD_URL=http://localhost:5173

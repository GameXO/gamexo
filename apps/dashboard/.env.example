# Copy to .env. Local dev only; contains no secrets.

# Where the FastAPI app is listening. The API's CORS_ORIGINS already allows
# http://localhost:5173 (Vite's default), so no dev proxy is needed.
VITE_API_BASE_URL=http://localhost:8000

# Which academy this dev build talks to. Sent as the X-Tenant-ID header, which
# the API accepts only while ALLOW_TENANT_HEADER=true — in production the tenant
# comes from the host subdomain instead and this value is ignored.
VITE_TENANT_SLUG=xcourt

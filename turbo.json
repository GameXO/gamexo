{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // `out/**` and `.next/**` are the docs app: Next.js writes its static export
      // to out/, not dist/, and without it here Turbo caches a build whose artefacts
      // it never restores — so a cache hit leaves nothing to deploy.
      "outputs": ["dist/**", "out/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "format": {
      "cache": false
    },
    "generate:api": {
      "cache": false,
      "outputs": ["src/api/openapi.json", "src/api/schema.d.ts"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
